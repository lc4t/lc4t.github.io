<section id="comments" class="mt-8 w-full" aria-labelledby="comments-title">
  <h2 id="comments-title" class="mb-3 text-xl font-semibold">Comments</h2>
  <button
    id="retry-comments"
    class="focus-outline text-sm text-skin-accent underline decoration-dashed underline-offset-4 hover:opacity-75"
    type="button"
    hidden
  >
    评论加载失败，点击重试
  </button>
  <p id="comments-status" class="sr-only" role="status" aria-live="polite"></p>
  <div id="giscus-container" class="mt-4" aria-busy="false"></div>
</section>

<script>
  const section = document.querySelector<HTMLElement>("#comments");
  const retryButton =
    document.querySelector<HTMLButtonElement>("#retry-comments");
  const status = document.querySelector<HTMLElement>("#comments-status");
  const container = document.querySelector<HTMLElement>("#giscus-container");

  const getTheme = () =>
    window.localStorage.getItem("theme") ||
    (window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light");

  const updateGiscusTheme = () => {
    const iframe = document.querySelector<HTMLIFrameElement>(
      "iframe.giscus-frame"
    );
    iframe?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: getTheme() } } },
      "https://giscus.app"
    );
  };

  const loadComments = () => {
    if (
      !container ||
      container.dataset.state === "loading" ||
      container.dataset.state === "loaded"
    )
      return;

    container.dataset.state = "loading";
    container.setAttribute("aria-busy", "true");
    retryButton?.setAttribute("hidden", "");
    if (status) status.textContent = "正在加载评论…";

    const script = document.createElement("script");
    script.src = "https://giscus.app/client.js";
    script.async = true;
    script.crossOrigin = "anonymous";
    script.setAttribute("data-repo", "lc4t/lc4t.github.io");
    script.setAttribute("data-repo-id", "MDEwOlJlcG9zaXRvcnk3NTIwNTYwNQ==");
    script.setAttribute("data-category", "Announcements");
    script.setAttribute("data-category-id", "DIC_kwDOBHuL5c4CgBti");
    script.setAttribute("data-mapping", "title");
    script.setAttribute("data-strict", "0");
    script.setAttribute("data-reactions-enabled", "1");
    script.setAttribute("data-emit-metadata", "0");
    script.setAttribute("data-input-position", "top");
    script.setAttribute("data-theme", getTheme());
    script.setAttribute("data-lang", "zh-CN");
    script.addEventListener("load", () => {
      container.dataset.state = "loaded";
      container.setAttribute("aria-busy", "false");
      if (status) status.textContent = "评论已加载";
    });
    script.addEventListener("error", () => {
      script.remove();
      container.dataset.state = "idle";
      container.setAttribute("aria-busy", "false");
      retryButton?.removeAttribute("hidden");
      if (status) status.textContent = "评论加载失败，可以点击重试";
    });
    container.append(script);
  };

  retryButton?.addEventListener("click", loadComments);

  if (section && "IntersectionObserver" in window) {
    const commentsObserver = new IntersectionObserver(
      entries => {
        if (entries.some(entry => entry.isIntersecting)) {
          commentsObserver.disconnect();
          loadComments();
        }
      },
      { rootMargin: "600px 0px" }
    );
    commentsObserver.observe(section);
  }

  const scheduleIdleLoad = () => {
    window.setTimeout(() => {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(loadComments, { timeout: 2000 });
      } else {
        loadComments();
      }
    }, 1200);
  };

  if (document.readyState === "complete") scheduleIdleLoad();
  else window.addEventListener("load", scheduleIdleLoad, { once: true });

  const themeObserver = new MutationObserver(updateGiscusTheme);
  themeObserver.observe(document.documentElement, {
    attributes: true,
    attributeFilter: ["data-theme"],
  });
</script>
