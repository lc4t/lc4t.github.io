---
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import QaCta from "@components/qa/QaCta.astro";
import QaAsker from "@components/qa/QaAsker.astro";
import getQaEntries from "@utils/getQaEntries";
import formatQaLetterDate from "@utils/formatQaLetterDate";
import { SITE } from "@config";

const entries = (await getQaEntries()).sort(
  (a, b) => b.data.letterDatetime.getTime() - a.data.letterDatetime.getTime()
);

// tag → 条数，按热度排序，作为筛选 chip
const tagCounts = new Map<string, number>();
for (const { data } of entries) {
  for (const tag of data.tags) {
    tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
  }
}
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);

const total = entries.length;
const latestLetterAt = entries[0]?.data.letterDatetime;
---

<Layout
  title={`读者信箱 | ${SITE.title}`}
  description="读者来信，我挑能公开的写一封回信。"
>
  <Header activeNav="qa" />

  <main id="main-content" class="qa-page">
    <header class="qa-masthead">
      <h1>读者信箱</h1>
      <div class="qa-masthead__issue">
        <span>READER MAILBOX</span>
        <span>
          {total > 0 ? `共 ${total} 封` : "尚无收录"}
          {
            latestLetterAt &&
              ` · 最近来信 ${formatQaLetterDate(latestLetterAt)}`
          }
        </span>
      </div>
    </header>

    <QaCta variant="full" />

    {
      tags.length > 0 && (
        <div class="qa-chips" role="group" aria-label="按标签筛选">
          <button
            class="qa-chip on"
            type="button"
            data-tag=""
            aria-pressed="true"
          >
            全部
          </button>
          {tags.map(([tag, count]) => (
            <button
              class="qa-chip"
              type="button"
              data-tag={tag}
              aria-pressed="false"
            >
              {tag}
              <span class="qa-chip__count">{count}</span>
            </button>
          ))}
        </div>
      )
    }

    {
      total > 0 ? (
        <ul class="qa-list">
          {entries.map(entry => (
            <li class="qa-row" data-tags={entry.data.tags.join("|")}>
              <a class="qa-row__link" href={`/qa/${entry.slug}/`}>
                <span class="qa-row__rail">
                  <time
                    datetime={entry.data.letterDatetime.toISOString()}
                    title="来信时间"
                  >
                    {formatQaLetterDate(entry.data.letterDatetime)}
                  </time>
                  <QaAsker
                    className="qa-row__who"
                    askerName={entry.data.askerName}
                    anonymous={entry.data.anonymous}
                  />
                </span>
                <span class="qa-row__q">
                  <span class="qa-row__title">{entry.data.listTitle}</span>
                  <span class="qa-row__description">
                    {entry.data.listDescription}
                  </span>
                  <span class="qa-row__tags">
                    {entry.data.tags.join(" · ")}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="qa-empty">第一封来信正在准备中，之后会在这里更新。</p>
      )
    }

    <p class="qa-empty" id="qa-empty" hidden>这个标签下暂时没有来信。</p>
  </main>

  <Footer />
</Layout>

<style>
  .qa-page {
    --qa-hair: rgba(var(--color-text-base), 0.14);
    margin: 0 auto;
    width: 100%;
    max-width: 48rem;
    padding: 0 1rem 3.5rem;
  }

  .qa-masthead {
    border-bottom: 2px solid rgb(var(--color-text-base));
    padding: 2.5rem 0 0.7rem;
  }
  .qa-masthead h1 {
    margin: 0;
    font-size: clamp(1.5rem, 6vw, 1.9rem);
    font-weight: 700;
    letter-spacing: 0.04em;
  }
  .qa-masthead__issue {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.5rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    opacity: 0.6;
  }

  /* ---- 筛选 chip ---- */
  .qa-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0 0 2rem;
  }
  .qa-chip {
    font: inherit;
    font-size: 0.74rem;
    line-height: 1;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--qa-hair);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.15s, border-color 0.15s, background-color 0.15s;
  }
  .qa-chip:hover {
    opacity: 1;
    border-color: rgb(var(--color-accent));
  }
  .qa-chip.on {
    background: rgb(var(--color-accent));
    color: rgb(var(--color-fill));
    border-color: rgb(var(--color-accent));
    opacity: 1;
  }
  .qa-chip__count {
    margin-left: 0.35rem;
    opacity: 0.6;
  }
  .qa-chip:focus-visible {
    outline: 2px dashed rgb(var(--color-accent));
    outline-offset: 2px;
  }

  /* ---- 列表 ---- */
  .qa-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .qa-row {
    border-top: 1px solid var(--qa-hair);
  }
  .qa-row:last-child {
    border-bottom: 1px solid var(--qa-hair);
  }
  .qa-row[hidden] {
    display: none;
  }
  .qa-row__link {
    display: grid;
    grid-template-columns: 8.5rem 1fr;
    gap: 0.4rem 1.25rem;
    padding: 1.2rem 0.25rem;
    color: inherit;
    text-decoration: none;
  }
  .qa-row__link:hover .qa-row__q {
    color: rgb(var(--color-accent));
  }
  .qa-row__link:focus-visible {
    outline: 2px dashed rgb(var(--color-accent));
    outline-offset: 2px;
  }
  .qa-row__rail {
    font-size: 0.73rem;
    line-height: 1.55;
    opacity: 0.62;
  }
  .qa-row__rail time {
    display: block;
    font-variant-numeric: tabular-nums;
  }
  .qa-row__who {
    color: rgb(var(--color-text-base));
    opacity: 0.85;
  }
  .qa-row__q {
    min-width: 0;
    transition: color 0.15s;
  }
  .qa-row__title {
    display: block;
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.5;
  }
  /* 列表使用独立摘要，来信原文保留在详情页。 */
  .qa-row__description {
    display: block;
    overflow-wrap: anywhere;
    margin-top: 0.45rem;
    font-size: 0.86rem;
    line-height: 1.8;
    font-weight: 400;
    color: rgb(var(--color-text-base));
    opacity: 0.75;
  }
  .qa-row__tags {
    display: block;
    margin-top: 0.4rem;
    font-size: 0.72rem;
    font-weight: 400;
    opacity: 0.5;
  }

  .qa-empty {
    margin: 1.6rem 0 0;
    font-size: 0.9rem;
    font-style: italic;
    opacity: 0.7;
  }

  @media (max-width: 480px) {
    .qa-row__link {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .qa-chip,
    .qa-row__q {
      transition: none;
    }
  }
</style>

<script>
  import { initQaFilter } from "@utils/qaFilter";

  initQaFilter();
</script>
