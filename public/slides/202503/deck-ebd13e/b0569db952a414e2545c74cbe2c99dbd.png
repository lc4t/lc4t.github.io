<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 800">
  <!-- 背景 -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#f9fbff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#eef5ff;stop-opacity:1" />
    </linearGradient>
    <filter id="dropShadow" height="130%">
      <feGaussianBlur in="SourceAlpha" stdDeviation="3"/> 
      <feOffset dx="2" dy="2" result="offsetblur"/>
      <feComponentTransfer>
        <feFuncA type="linear" slope="0.2"/>
      </feComponentTransfer>
      <feMerge> 
        <feMergeNode/>
        <feMergeNode in="SourceGraphic"/> 
      </feMerge>
    </filter>
    <radialGradient id="m2Gradient" cx="50%" cy="50%" r="50%" fx="50%" fy="50%">
      <stop offset="0%" style="stop-color:#e6f0ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#c9e0ff;stop-opacity:1" />
    </radialGradient>
    <radialGradient id="m1Gradient" cx="50%" cy="50%" r="50%" fx="50%" fy="50%">
      <stop offset="0%" style="stop-color:#cde3ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#add5ff;stop-opacity:1" />
    </radialGradient>
    <radialGradient id="m0Gradient" cx="50%" cy="50%" r="50%" fx="50%" fy="50%">
      <stop offset="0%" style="stop-color:#b5dbff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#8cc6ff;stop-opacity:1" />
    </radialGradient>
    <linearGradient id="individualGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#fff8e6;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#ffe9c4;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="corporateGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e7f5e9;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#c5e8c8;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="governmentGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#e6f0ff;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#c7dbff;stop-opacity:1" />
    </linearGradient>
  </defs>
  
  <!-- 背景 -->
  <rect width="1000" height="800" fill="url(#bgGradient)"/>
  
  <!-- 标题和副标题 -->
  <g filter="url(#dropShadow)">
    <text x="500" y="60" font-family="Arial, SimHei, sans-serif" font-size="32" text-anchor="middle" font-weight="bold" fill="#1a365d">中国货币供应量与经济行为关系图</text>
    <text x="500" y="95" font-family="Arial, SimHei, sans-serif" font-size="20" text-anchor="middle" font-style="italic" fill="#2c5282">（2025年1月新口径）</text>
  </g>
  
  <!-- 上半部分：货币供应量层次关系 -->
  <g transform="translate(0, -20)">
    <!-- M2大圆 -->
    <ellipse cx="500" cy="300" rx="350" ry="180" fill="url(#m2Gradient)" stroke="#4682B4" stroke-width="3" filter="url(#dropShadow)"/>
    <text x="500" y="160" font-family="Arial, SimHei, sans-serif" font-size="28" text-anchor="middle" font-weight="bold" fill="#1E5C9B">M2 (广义货币)</text>
    
    <!-- M1中圆 -->
    <ellipse cx="500" cy="320" rx="260" ry="130" fill="url(#m1Gradient)" stroke="#4682B4" stroke-width="3" filter="url(#dropShadow)"/>
    <text x="500" y="230" font-family="Arial, SimHei, sans-serif" font-size="24" text-anchor="middle" font-weight="bold" fill="#1E5C9B">M1 (狭义货币)</text>
    <text x="500" y="260" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" font-style="italic" fill="#1E5C9B">2025年1月新口径</text>
    
    <!-- M0小圆 -->
    <circle cx="500" cy="340" r="80" fill="url(#m0Gradient)" stroke="#4682B4" stroke-width="3" filter="url(#dropShadow)"/>
    <text x="500" y="335" font-family="Arial, SimHei, sans-serif" font-size="22" text-anchor="middle" font-weight="bold" fill="#1E5C9B">M0</text>
    <text x="500" y="360" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#1E5C9B">(流通中货币)</text>
    
    <!-- M0组件 -->
    <text x="500" y="390" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#333">现金流通</text>
    
    <!-- M1组件（除M0外） -->
    <g>
      <rect x="265" y="275" width="130" height="24" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="330" y="290" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#333">单位活期存款</text>
    </g>
    
    <g>
      <rect x="370" y="225" width="140" height="24" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="440" y="240" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#333">个人活期存款 ★</text>
    </g>
    
    <g>
      <rect x="540" y="260" width="160" height="24" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="620" y="275" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#333">非银行支付机构</text>
    </g>
    
    <g>
      <rect x="540" y="290" width="160" height="24" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="620" y="305" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#333">客户备付金 ★</text>
    </g>
    
    <!-- M2组件（除M1外） -->
    <g>
      <rect x="180" y="350" width="170" height="24" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="265" y="365" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#333">单位定期和其他存款</text>
    </g>
    
    <g>
      <rect x="650" y="350" width="130" height="24" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="715" y="365" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#333">个人定期存款</text>
    </g>
    
    <g>
      <rect x="650" y="390" width="170" height="24" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="735" y="405" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#333">非存款类金融机构存款</text>
    </g>
    
    <g>
      <rect x="230" y="410" width="200" height="24" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="330" y="425" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#333">非存款机构部门持有的</text>
    </g>
    
    <g>
      <rect x="230" y="440" width="200" height="24" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="330" y="455" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#333">货币市场基金份额</text>
    </g>
  </g>
  
  <!-- 图例 -->
  <g transform="translate(780, 160)">
    <rect x="0" y="0" width="180" height="160" rx="10" ry="10" fill="white" fill-opacity="0.8" stroke="#ccc" stroke-width="1"/>
    <text x="90" y="30" font-family="Arial, SimHei, sans-serif" font-size="18" text-anchor="middle" font-weight="bold" fill="#1E5C9B">图例</text>
    
    <rect x="20" y="50" width="20" height="20" fill="url(#m0Gradient)" stroke="#4682B4" stroke-width="1" rx="3" ry="3"/>
    <text x="50" y="65" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#333">M0 (流通中货币)</text>
    
    <rect x="20" y="80" width="20" height="20" fill="url(#m1Gradient)" stroke="#4682B4" stroke-width="1" rx="3" ry="3"/>
    <text x="50" y="95" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#333">M1 (狭义货币)</text>
    
    <rect x="20" y="110" width="20" height="20" fill="url(#m2Gradient)" stroke="#4682B4" stroke-width="1" rx="3" ry="3"/>
    <text x="50" y="125" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#333">M2 (广义货币)</text>
    
    <text x="90" y="150" font-family="Arial, SimHei, sans-serif" font-size="14" text-anchor="middle" fill="#1E5C9B">★ 2025年1月新纳入M1的项目</text>
  </g>
  
  <!-- 下半部分：货币与经济行为关系 -->
  <text x="500" y="520" font-family="Arial, SimHei, sans-serif" font-size="28" text-anchor="middle" font-weight="bold" fill="#1E5C9B">货币供应量与经济主体关系</text>
  
  <!-- 三个经济主体 -->
  <g transform="translate(0, 30)">
    <rect x="140" y="520" width="200" height="220" rx="15" ry="15" fill="url(#individualGradient)" stroke="#E69138" stroke-width="3" filter="url(#dropShadow)"/>
    <text x="240" y="550" font-family="Arial, SimHei, sans-serif" font-size="22" text-anchor="middle" font-weight="bold" fill="#994C00">个人/家庭</text>
    
    <rect x="400" y="520" width="200" height="220" rx="15" ry="15" fill="url(#corporateGradient)" stroke="#82B366" stroke-width="3" filter="url(#dropShadow)"/>
    <text x="500" y="550" font-family="Arial, SimHei, sans-serif" font-size="22" text-anchor="middle" font-weight="bold" fill="#336600">企业</text>
    
    <rect x="660" y="520" width="200" height="220" rx="15" ry="15" fill="url(#governmentGradient)" stroke="#6C8EBF" stroke-width="3" filter="url(#dropShadow)"/>
    <text x="760" y="550" font-family="Arial, SimHei, sans-serif" font-size="22" text-anchor="middle" font-weight="bold" fill="#0D5AA7">政府</text>
  
    <!-- 个人/家庭行为 -->
    <g>
      <rect x="155" y="575" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="165" y="595" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#994C00">消费（M0、M1）</text>
    </g>
    
    <g>
      <rect x="155" y="610" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="165" y="630" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#994C00">短期储蓄（M1）</text>
    </g>
    
    <g>
      <rect x="155" y="645" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="165" y="665" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#994C00">长期储蓄（M2）</text>
    </g>
    
    <g>
      <rect x="155" y="680" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="165" y="700" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#994C00">小额投资（M1、M2）</text>
    </g>
    
    <!-- 企业行为 -->
    <g>
      <rect x="415" y="575" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="425" y="595" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#336600">流动资金（M1）</text>
    </g>
    
    <g>
      <rect x="415" y="610" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="425" y="630" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#336600">经营支出（M0、M1）</text>
    </g>
    
    <g>
      <rect x="415" y="645" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="425" y="665" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#336600">储备资金（M2）</text>
    </g>
    
    <g>
      <rect x="415" y="680" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="425" y="700" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#336600">长期投资（M2）</text>
    </g>
    
    <!-- 政府行为 -->
    <g>
      <rect x="675" y="575" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="685" y="595" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#0D5AA7">财政支出（M1）</text>
    </g>
    
    <g>
      <rect x="675" y="610" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="685" y="630" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#0D5AA7">短期资金（M1）</text>
    </g>
    
    <g>
      <rect x="675" y="645" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="685" y="665" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#0D5AA7">财政储备（M2）</text>
    </g>
    
    <g>
      <rect x="675" y="680" width="170" height="28" rx="5" ry="5" fill="white" fill-opacity="0.7"/>
      <text x="685" y="700" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="start" fill="#0D5AA7">基础设施投资（M1、M2）</text>
    </g>
  </g>
  
  <!-- 连接线 -->
  <!-- M0到经济行为的连接 -->
  <path d="M480 370 L240 605" stroke="#8cc6ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M520 370 L500 640" stroke="#8cc6ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  
  <!-- M1到经济行为的连接 -->
  <path d="M380 320 L240 605" stroke="#add5ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M380 320 L240 640" stroke="#add5ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M380 320 L240 710" stroke="#add5ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M500 320 L500 605" stroke="#add5ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M500 320 L500 640" stroke="#add5ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M620 320 L760 605" stroke="#add5ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M620 320 L760 640" stroke="#add5ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M620 320 L760 710" stroke="#add5ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  
  <!-- M2到经济行为的连接 -->
  <path d="M330 270 L240 675" stroke="#c9e0ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M500 270 L500 675" stroke="#c9e0ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M500 270 L500 710" stroke="#c9e0ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  <path d="M670 270 L760 675" stroke="#c9e0ff" stroke-width="3" stroke-dasharray="6,4" fill="none" opacity="0.7"/>
  
  <!-- 2025年M1调整注解 -->
  <g transform="translate(500, 775)" filter="url(#dropShadow)">
    <rect x="-400" y="-25" width="800" height="40" rx="20" ry="20" fill="white" fill-opacity="0.8" stroke="#4682B4" stroke-width="1"/>
    <text x="0" y="0" font-family="Arial, SimHei, sans-serif" font-size="16" text-anchor="middle" fill="#1E5C9B">
      注：图示展示了中国人民银行2025年1月起实施的新M1统计口径及其与经济主体行为的关联
    </text>
  </g>
</svg>
