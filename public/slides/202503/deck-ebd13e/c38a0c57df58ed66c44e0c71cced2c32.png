<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600">
  <!-- 背景 -->
  <rect width="800" height="600" fill="#f9f9f9"/>
  
  <!-- 坐标轴 -->
  <line x1="100" y1="500" x2="700" y2="500" stroke="#333" stroke-width="2"/>
  <line x1="100" y1="100" x2="100" y2="500" stroke="#333" stroke-width="2"/>
  
  <!-- 坐标轴箭头 -->
  <polygon points="700,500 690,495 690,505" fill="#333"/>
  <polygon points="100,100 95,110 105,110" fill="#333"/>
  
  <!-- 坐标轴标签 -->
  <text x="400" y="550" text-anchor="middle" font-family="Arial" font-size="20" fill="#333">失业率 (u)</text>
  <text x="40" y="300" text-anchor="middle" font-family="Arial" font-size="20" fill="#333" transform="rotate(-90, 40, 300)">通货膨胀率 (π)</text>
  
  <!-- 刻度和刻度值 -->
  <!-- 失业率刻度 -->
  <line x1="200" y1="500" x2="200" y2="510" stroke="#333" stroke-width="2"/>
  <line x1="300" y1="500" x2="300" y2="510" stroke="#333" stroke-width="2"/>
  <line x1="400" y1="500" x2="400" y2="510" stroke="#333" stroke-width="2"/>
  <line x1="500" y1="500" x2="500" y2="510" stroke="#333" stroke-width="2"/>
  <line x1="600" y1="500" x2="600" y2="510" stroke="#333" stroke-width="2"/>
  
  <text x="200" y="530" text-anchor="middle" font-family="Arial" font-size="14" fill="#333">2%</text>
  <text x="300" y="530" text-anchor="middle" font-family="Arial" font-size="14" fill="#333">4%</text>
  <text x="400" y="530" text-anchor="middle" font-family="Arial" font-size="14" fill="#333">6%</text>
  <text x="500" y="530" text-anchor="middle" font-family="Arial" font-size="14" fill="#333">8%</text>
  <text x="600" y="530" text-anchor="middle" font-family="Arial" font-size="14" fill="#333">10%</text>
  
  <!-- 通胀率刻度 -->
  <line x1="90" y1="450" x2="100" y2="450" stroke="#333" stroke-width="2"/>
  <line x1="90" y1="400" x2="100" y2="400" stroke="#333" stroke-width="2"/>
  <line x1="90" y1="350" x2="100" y2="350" stroke="#333" stroke-width="2"/>
  <line x1="90" y1="300" x2="100" y2="300" stroke="#333" stroke-width="2"/>
  <line x1="90" y1="250" x2="100" y2="250" stroke="#333" stroke-width="2"/>
  <line x1="90" y1="200" x2="100" y2="200" stroke="#333" stroke-width="2"/>
  <line x1="90" y1="150" x2="100" y2="150" stroke="#333" stroke-width="2"/>
  
  <text x="80" y="450" text-anchor="end" font-family="Arial" font-size="14" fill="#333">1%</text>
  <text x="80" y="400" text-anchor="end" font-family="Arial" font-size="14" fill="#333">2%</text>
  <text x="80" y="350" text-anchor="end" font-family="Arial" font-size="14" fill="#333">3%</text>
  <text x="80" y="300" text-anchor="end" font-family="Arial" font-size="14" fill="#333">4%</text>
  <text x="80" y="250" text-anchor="end" font-family="Arial" font-size="14" fill="#333">5%</text>
  <text x="80" y="200" text-anchor="end" font-family="Arial" font-size="14" fill="#333">6%</text>
  <text x="80" y="150" text-anchor="end" font-family="Arial" font-size="14" fill="#333">7%</text>
  
  <!-- 原始菲利普斯曲线 -->
  <path d="M 150,150 Q 300,250 400,300 T 650,450" fill="none" stroke="#0066cc" stroke-width="4"/>
  <text x="200" y="170" font-family="Arial" font-size="16" fill="#0066cc" font-weight="bold">原始菲利普斯曲线</text>
  <text x="200" y="190" font-family="Arial" font-size="14" fill="#0066cc">π = f(u)</text>
  
  <!-- 自然失业率垂直线 -->
  <line x1="400" y1="150" x2="400" y2="500" stroke="#ff6600" stroke-width="2" stroke-dasharray="5,5"/>
  <text x="415" y="180" font-family="Arial" font-size="16" fill="#ff6600">自然失业率 (u*)</text>
  
  <!-- 供给冲击 -->
  <path d="M 150,220 Q 300,320 400,370 T 650,520" fill="none" stroke="#009900" stroke-width="4" stroke-dasharray="10,5"/>
  <text x="500" y="420" font-family="Arial" font-size="16" fill="#009900">供给冲击后的菲利普斯曲线</text>
  <text x="500" y="440" font-family="Arial" font-size="14" fill="#009900">π = πᵉ + β(u - u*) + ε</text>
  
  <!-- 预期通胀的影响（向上移动的菲利普斯曲线） -->
  <path d="M 150,100 Q 300,200 400,250 T 650,400" fill="none" stroke="#cc3366" stroke-width="4" stroke-dasharray="5,5"/>
  <text x="550" y="230" font-family="Arial" font-size="16" fill="#cc3366">预期通胀上升时</text>
  <text x="550" y="250" font-family="Arial" font-size="14" fill="#cc3366">πᵉ ↑</text>
  
  <!-- 解释面板 -->
  <rect x="500" y="80" width="280" height="120" fill="white" stroke="#333" stroke-width="1" rx="5" ry="5"/>
  <text x="520" y="100" font-family="Arial" font-size="14" font-weight="bold" fill="#333">变量说明:</text>
  <text x="520" y="125" font-family="Arial" font-size="14" fill="#333">π: 通货膨胀率</text>
  <text x="520" y="145" font-family="Arial" font-size="14" fill="#333">u: 失业率</text>
  <text x="520" y="165" font-family="Arial" font-size="14" fill="#333">πᵉ: 预期通货膨胀率</text>
  <text x="520" y="185" font-family="Arial" font-size="14" fill="#333">ε: 供给冲击</text>
  
  <!-- 图表标题 -->
  <text x="400" y="50" text-anchor="middle" font-family="Arial" font-size="24" font-weight="bold" fill="#333">菲利普斯曲线关系</text>
</svg>
